{
  "name": "trustvault",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "node scripts/generate.mjs && next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "test": "tsx --test tests/browser-workspace.test.ts tests/workspace-client.test.ts tests/hosted-storage.test.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/generate.mjs",
    "db:generate": "node scripts/generate.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "auth:provision": "tsx scripts/provision.ts",
    "setup:server": "tsx scripts/setup.ts",
    "test:server": "tsx scripts/test.ts",
    "db:migrate:postgres": "node scripts/migrate-postgres.mjs",
    "tidecloak:prepare": "node scripts/tidecloak.mjs prepare",
    "tidecloak:start": "node scripts/tidecloak.mjs start",
    "tidecloak:status": "node scripts/tidecloak.mjs status",
    "tidecloak:stop": "node scripts/tidecloak.mjs stop",
    "auth:doctor": "node scripts/auth-doctor.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.2.12",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^4.1.0",
    "@prisma/client": "6.19.0",
    "@tidecloak/nextjs": "0.14.40",
    "jose": "^6.1.0",
    "@next/env": "16.2.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.6.2",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "prisma": "6.19.0",
    "dotenv": "^17.2.0"
  },
  "engines": {
    "node": "24.x"
  }
}
