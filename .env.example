# Default: real TideCloak. Set WORKSPACE_MODE=demo only for the synthetic browser demo.
WORKSPACE_MODE="tidecloak"
AUTH_MODE="tidecloak"
APP_ORIGIN="http://127.0.0.1:3000"
SESSION_SECRET=""
DOCUMENT_ENCRYPTION_KEY=""
# Local development uses a separate SQLite file/private directory.
DATABASE_BACKEND="sqlite"
DATABASE_URL="file:./trustvault-tidecloak.db"
STORAGE_BACKEND="local"
STORAGE_DIR="./private-storage-tidecloak"
# For Vercel: DATABASE_BACKEND=postgresql, STORAGE_BACKEND=vercel-blob.
# Neon pooled URL for runtime; direct URL for explicit migrations. Never migrate during build.
POSTGRES_DATABASE_URL=""
POSTGRES_MIGRATION_URL=""
BLOB_READ_WRITE_TOKEN=""
# Download the Tide adapter for the actual client; keep its JSON server-only.
TIDECLOAK_CONFIG_JSON=""
TIDECLOAK_ISSUER="http://localhost:8080/realms/trustvault"
TIDECLOAK_CLIENT_ID="trustvault"
TIDECLOAK_CLIENT_SECRET=""
