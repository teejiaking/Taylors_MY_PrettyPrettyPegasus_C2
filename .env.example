DATABASE_URL="file:./trustvault-supabase.db"
AUTH_MODE="supabase"
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
# Normal production startup rejects demo auth. npm run demo is an explicit loopback-only preview.
APP_ORIGIN="http://127.0.0.1:3000"
# Generate both with npm run setup (or demo:setup). Never commit real keys.
SESSION_SECRET=""
DOCUMENT_ENCRYPTION_KEY=""
STORAGE_DIR="./private-storage-supabase"
# Vercel uses durable Supabase Postgres and a private encrypted Storage bucket.
# For local SQLite, leave these backends as shown. Vercel requires supabase.
DATABASE_BACKEND="sqlite"
STORAGE_BACKEND="local"
SUPABASE_DATABASE_URL=""
# Optional separate Session pooler URL for production-build migrations.
SUPABASE_MIGRATION_DATABASE_URL=""
# Server-only secret/service_role key. Never use a NEXT_PUBLIC_ variable.
SUPABASE_SECRET_KEY=""
SUPABASE_STORAGE_BUCKET="trustvault-documents"
# Real mode: AUTH_MODE=tidecloak; server-only adapter JSON downloaded from your realm client
TIDECLOAK_CONFIG_JSON=""
TIDECLOAK_ISSUER=""
TIDECLOAK_CLIENT_ID="trustvault"
# For OIDC code+PKCE, use a confidential client and configure its secret server-side.
TIDECLOAK_CLIENT_SECRET=""
